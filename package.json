  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.js",
    "test:browser": "node tools/runBrowserTests.mjs",
    "test:browser:dev": "node tools/runBrowserTests.mjs --serve development",
    "test:browser:production": "node tools/runBrowserTests.mjs --serve production",
    "test:pages": "node tools/runBrowserTests.mjs --serve production --smoke",
    "verify:resources:ci": "node tools/verifyResources.mjs --ci",
    "verify:resources:local": "node tools/verifyResources.mjs --local",
    "test:pwa": "node test/pwaUpdates.browser.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
